# ───────── Supabase ─────────
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role: write path (crawlers, ingest, pipeline_state). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# publishable/anon: read-only public path (static site consuming articles table)
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ───────── Publisher state mode ─────────
# true → publisher uses Supabase publish_log (recommended for GH Actions)
# false → uses local data/published.json (legacy)
USE_DB=true

# ───────── Telegram ─────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_id

# ───────── X (Twitter) — OAuth 1.0a User Context publishing ─────────
X_API_KEY=your_consumer_api_key
X_API_SECRET=your_consumer_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret

# Legacy OAuth 2.0 values can stay empty; posting does not use them.
X_CLIENT_ID=your_client_id
X_CLIENT_SECRET=your_client_secret
X_REFRESH_TOKEN=your_refresh_token
# Optional read fallback for crawlers/x_watch.py if Nitter RSS stops responding.
# X API v2 read usage is billed/limited by X; leave empty unless explicitly enabled.
X_BEARER_TOKEN=

# ───────── X watch crawler ─────────
# Comma-separated Nitter instance URLs. First working RSS feed wins per account.
NITTER_INSTANCES=https://nitter.net

# X trigger review flow
# Default scan scope is auto, the low-cost tier. Manual runs can choose core/fast/scoop/oss/coding/research/benchmark/all.
TRIGGER_SCAN_SCOPE=auto
TRIGGER_SCAN_MAX_RESULTS=1
# Feed modes: nitter, rsshub, nitter-first, rsshub-first. Default uses Nitter, then RSSHub fallbacks.
X_TRIGGER_FEED_MODE=nitter-first
X_TRIGGER_FEED_TIMEOUT_SECONDS=15
X_TRIGGER_FEED_RETRIES=2
X_TRIGGER_PER_ACCOUNT_DELAY_SECONDS=1.5
# Optional comma-separated RSSHub-compatible base URLs for explicit rsshub/rsshub-first modes.
X_TRIGGER_FEED_BASE_URLS=https://rsshub.pseudoyu.com,https://rsshub.app,https://rsshub.rssforever.com,https://rss.detools.dev
# Optional comma-separated Nitter instances. First working RSS feed wins per account.
X_TRIGGER_NITTER_INSTANCES=https://nitter.net
# Optional comma-separated GitHub usernames. If empty, GitHub OWNER/MEMBER/COLLABORATOR comments can approve.
TRIGGER_REVIEWERS=github_user_1,github_user_2
# Optional private Telegram chat for review notifications. GitHub Issues remains the approval source of truth.
TRIGGER_REVIEW_TELEGRAM_CHAT_ID=
# telegram, x, or both
TRIGGER_PUBLISH_PLATFORM=both

# ───────── LLM (article generation) ─────────
GOOGLE_API_KEY=your_key
# Multi-key rotation: comma-separated, overrides GOOGLE_API_KEY if set
# GOOGLE_API_KEYS=key1,key2,key3

# ───────── Discord (local crawl only, do not put in GH Secrets) ─────────
DISCORD_TOKEN=local_only_do_not_commit
